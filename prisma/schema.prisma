generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id        String    @id @default(cuid())
  name      String
  color     String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model ArtHandler {
  id               String           @id @default(cuid())
  name             String
  email            String
  color            String
  level            String
  type             String
  canDriveTruck    Boolean          @default(false)
  canDriveCar      Boolean          @default(false)
  canDriveForklift Boolean          @default(false)
  hasBadgeLouvre   Boolean          @default(false)
  notes            String?
  bookings         Booking[]
  unavailabilities Unavailability[]
  createdAt        DateTime         @default(now())
}

model Truck {
  id               String               @id @default(cuid())
  name             String
  licensePlate     String?
  bookings         TruckBooking[]
  unavailabilities TruckUnavailability[]
  createdAt        DateTime             @default(now())
}

model Project {
  id            String         @id @default(cuid())
  projectNumber String
  title         String
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  description   String?
  location      String?
  date          DateTime
  status        String         @default("PRE_BOOKED")
  createdBy     String
  bookings      Booking[]
  truckBookings TruckBooking[]
  createdAt     DateTime       @default(now())
}

model Booking {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  handlerId String
  handler   ArtHandler @relation(fields: [handlerId], references: [id])
  date      DateTime
  createdAt DateTime   @default(now())
}

model TruckBooking {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  date      DateTime
  createdAt DateTime @default(now())
}

model Unavailability {
  id        String     @id @default(cuid())
  handlerId String
  handler   ArtHandler @relation(fields: [handlerId], references: [id])
  date      DateTime
  reason    String?
  createdAt DateTime   @default(now())
}

model TruckUnavailability {
  id        String   @id @default(cuid())
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}
